PORT=3000
LOG_LEVEL=info

# Use "mock" for the bounded in-process WMS adapter, or "http" for a WMS System API.
WMS_MODE=mock
WMS_BASE_URL=http://127.0.0.1:3100/api/v1/wms
WMS_TIMEOUT_MS=3000
WMS_MOCK_PORT=3100
# JSON SKU-to-quantity map for the Mock WMS.
WMS_MOCK_INVENTORY='{"SKU-0001":50,"SKU123":50,"SKU-LOW-STOCK":2,"SKU-OUT-OF-STOCK":0}'

RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_RECONNECT_MS=3000
WMS_RETRY_DELAY_MS=5000
# Set to a SKU to simulate a WMS reservation failure until it reaches the DLQ.
WMS_FAIL_SKU=
STATE_DIR=state

TMS_BASE_URL=http://127.0.0.1:3300/api/v1/tms
TMS_TIMEOUT_MS=3000
TMS_MOCK_PORT=3300
# Standalone Mock CRM listen port.
CRM_MOCK_PORT=3200

AI_MAPPING_SERVICE_URL=http://127.0.0.1:3400
AI_MAPPING_TIMEOUT_MS=35000
# Gemini credentials/configuration belong in ai_mapping/.env so Node never loads the API key.

BATCH_INPUT_FILE=data/products.json
# Start the local mock Batch Receiver before running the Batch Sender.
BATCH_TARGET_URL=http://127.0.0.1:3500/api/v1/products/batch
# Mock Batch Receiver listen port.
BATCH_RECEIVER_PORT=3500
BATCH_TIMEOUT_MS=10000
BATCH_CRON_TIMEZONE=Asia/Ho_Chi_Minh
