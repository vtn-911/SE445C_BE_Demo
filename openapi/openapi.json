{
  "openapi": "3.0.3",
  "info": {
    "title": "ABC Retail Integration API",
    "version": "1.0.0",
    "description": "Phase 2 integration APIs. Public inventory requests use the Process API; WMS remains behind the integration layer."
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/v1/inventory/{sku}": {
      "get": {
        "operationId": "getInventoryBySku",
        "summary": "Look up current inventory for a SKU",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "required": ["sku", "availableQuantity"],
                      "properties": {
                        "sku": { "type": "string", "example": "SKU123" },
                        "availableQuantity": { "type": "integer", "minimum": 0, "example": 50 }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": { "sku": "SKU123", "availableQuantity": 50 }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      }
    },
    "/api/v1/products/{id}/stock": {
      "get": {
        "operationId": "getProductStockById",
        "summary": "Look up current inventory for a product",
        "description": "In this project, the Product ID is the product SKU.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 100 },
            "description": "Product ID; this value is the SKU in the product catalog."
          }
        ],
        "responses": {
          "200": {
            "description": "Product and current stock found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "required": ["productId", "sku", "availableQuantity"],
                      "properties": {
                        "productId": { "type": "string", "example": "SKU-0001" },
                        "sku": { "type": "string", "example": "SKU-0001" },
                        "availableQuantity": { "type": "integer", "minimum": 0, "example": 50 }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "productId": "SKU-0001",
                    "sku": "SKU-0001",
                    "availableQuantity": 50
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/ProductStockNotFound" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      }
    },
    "/api/v1/crm/customers/{id}/points": {
      "put": {
        "operationId": "setMockCrmCustomerPoints",
        "summary": "Set the loyalty points balance for a demo customer",
        "description": "Replaces the customer's total points balance. Repeating the same request is idempotent.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["points"],
                "additionalProperties": false,
                "properties": {
                  "points": { "type": "integer", "minimum": 0 }
                }
              },
              "example": { "points": 120 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer points balance updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["success", "data"],
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "required": ["customerId", "points"],
                      "properties": {
                        "customerId": { "type": "string", "example": "CUST-0001" },
                        "points": { "type": "integer", "minimum": 0, "example": 120 }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": { "customerId": "CUST-0001", "points": 120 }
                }
              }
            }
          },
          "400": {
            "description": "Customer ID or points payload is invalid",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": { "code": "INVALID_POINTS", "message": "points must be a non-negative safe integer" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Customer is not present in the Mock CRM demo data",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": { "code": "CUSTOMER_NOT_FOUND", "message": "Customer was not found" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wms/inventory/{sku}": {
      "servers": [
        {
          "url": "http://localhost:{port}",
          "variables": { "port": { "default": "3100" } }
        }
      ],
      "get": {
        "operationId": "getMockWmsInventory",
        "summary": "Read inventory from the Mock WMS",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "Mock inventory returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["sku", "availableQuantity"],
                  "properties": {
                    "sku": { "type": "string" },
                    "availableQuantity": { "type": "integer", "minimum": 0 }
                  }
                },
                "example": { "sku": "SKU123", "availableQuantity": 50 }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tms/shipments": {
      "servers": [
        {
          "url": "http://localhost:{port}",
          "variables": { "port": { "default": "3300" } }
        }
      ],
      "post": {
        "operationId": "createMockTmsShipment",
        "summary": "Create or retrieve an idempotent Mock TMS shipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["eventId", "orderId", "customerId", "items"],
                "properties": {
                  "eventId": { "type": "string", "minLength": 1 },
                  "orderId": { "type": "string", "minLength": 1 },
                  "customerId": { "type": "string", "minLength": 1 },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["sku", "quantity"],
                      "properties": {
                        "sku": { "type": "string", "minLength": 1 },
                        "quantity": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              },
              "example": {
                "eventId": "event-id",
                "orderId": "order-id",
                "customerId": "customer-1001",
                "items": [{ "sku": "SKU123", "quantity": 2 }]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Shipment created",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "shipment": {
                      "shipmentId": "shipment-id",
                      "eventId": "event-id",
                      "orderId": "order-id",
                      "customerId": "customer-1001",
                      "items": [{ "sku": "SKU123", "quantity": 2 }],
                      "status": "created",
                      "createdAt": "2026-01-01T00:00:00.000Z"
                    },
                    "duplicate": false
                  }
                }
              }
            }
          },
          "200": { "description": "Matching shipment already exists for this eventId" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/IdempotencyConflict" }
        }
      }
    },
    "/api/v1/data-mapping/products": {
      "post": {
        "operationId": "mapLegacyProduct",
        "summary": "Map legacy JSON/XML to Canonical Product v1",
        "description": "Gemini proposes source paths from field names and types only. Python applies the proposal to the source values and validates the result. No catalog, Order, Outbox, or RabbitMQ state is changed.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["format", "payload"],
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": ["json", "xml"]
                  },
                  "payload": {
                    "description": "For format=json, an object; for format=xml, an XML string.",
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": true
                      },
                      { "type": "string" }
                    ]
                  }
                }
              },
              "examples": {
                "legacyJson": {
                  "value": {
                    "format": "json",
                    "payload": {
                      "ProductCode": "SKU-0001",
                      "ProductName": "Organic Apples 1",
                      "ProductCategory": "Fresh Produce",
                      "UnitPrice": 4.99
                    }
                  }
                },
                "legacyXml": {
                  "value": {
                    "format": "xml",
                    "payload": "<Product><ProductCode>SKU-0001</ProductCode><ProductName>Organic Apples 1</ProductName><ProductCategory>Fresh Produce</ProductCategory><UnitPrice>4.99</UnitPrice></Product>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Legacy record mapped and validated as Canonical Product v1",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "canonicalVersion", "data", "mapping", "confidence", "warnings"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success"] },
                    "canonicalVersion": { "type": "string", "enum": ["Product-v1"] },
                    "data": {
                      "type": "object",
                      "required": ["sku", "name", "category", "price"],
                      "properties": {
                        "sku": { "type": "string", "minLength": 1, "example": "SKU-0001" },
                        "name": { "type": "string", "minLength": 1, "example": "Organic Apples 1" },
                        "category": { "type": "string", "minLength": 1, "example": "Fresh Produce" },
                        "price": { "type": "number", "minimum": 0, "example": 4.99 }
                      }
                    },
                    "mapping": {
                      "type": "object",
                      "properties": {
                        "sku": { "type": "string" },
                        "name": { "type": "string" },
                        "category": { "type": "string" },
                        "price": { "type": "string" }
                      },
                      "additionalProperties": false
                    },
                    "confidence": { "type": "string", "enum": ["high"] },
                    "warnings": { "type": "array", "items": { "type": "string" } }
                  }
                },
                "example": {
                  "status": "success",
                  "canonicalVersion": "Product-v1",
                  "data": {
                    "sku": "SKU-0001",
                    "name": "Organic Apples 1",
                    "category": "Fresh Produce",
                    "price": 4.99
                  },
                  "mapping": {
                    "sku": "/ProductCode",
                    "name": "/ProductName",
                    "category": "/ProductCategory",
                    "price": "/UnitPrice"
                  },
                  "confidence": "high",
                  "warnings": []
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/MappingBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/MappingPayloadTooLarge" },
          "422": { "$ref": "#/components/responses/MappingNeedsReview" },
          "502": { "$ref": "#/components/responses/MappingBadGateway" },
          "503": { "$ref": "#/components/responses/MappingUnavailable" },
          "504": { "$ref": "#/components/responses/MappingTimeout" }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Accept an order for asynchronous processing",
        "description": "Persists the order and outbox event before returning. Payment, WMS and notification consumers process the event independently.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customerId", "items"],
                "properties": {
                  "customerId": { "type": "string", "minLength": 1 },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["sku", "quantity"],
                      "properties": {
                        "sku": { "type": "string", "minLength": 1 },
                        "quantity": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              },
              "example": {
                "customerId": "customer-1001",
                "items": [{ "sku": "SKU123", "quantity": 2 }]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Order durably accepted for asynchronous processing",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": { "orderId": "9be0ef0a-5c0d-4c0d-a4b3-e7c2d74d13a0", "status": "accepted" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/InsufficientStock" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" },
          "504": { "$ref": "#/components/responses/GatewayTimeout" }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Check integration API availability",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "example": { "success": true, "status": "ok" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "A valid JWT bearer token is required",
        "content": {
          "application/json": {
            "example": { "message": "Unauthorized" }
          }
        }
      },
      "ProductStockNotFound": {
        "description": "The Product ID is not in the product catalog or the WMS has no inventory record for its SKU",
        "content": {
          "application/json": {
            "examples": {
              "productNotFound": {
                "value": {
                  "success": false,
                  "error": { "code": "PRODUCT_NOT_FOUND", "message": "Product was not found" }
                }
              },
              "skuNotFoundInWms": {
                "value": {
                  "success": false,
                  "error": { "code": "SKU_NOT_FOUND", "message": "SKU was not found" }
                }
              }
            }
          }
        }
      },
      "MappingBadRequest": {
        "description": "The mapping envelope or JSON/XML source payload is malformed",
        "content": {
          "application/json": {
            "example": {
              "status": "error",
              "error": { "code": "INVALID_XML", "message": "XML payload is malformed or contains prohibited declarations" }
            }
          }
        }
      },
      "MappingPayloadTooLarge": {
        "description": "The mapping request exceeds the 1 MiB request limit",
        "content": {
          "application/json": {
            "example": {
              "status": "error",
              "error": { "code": "PAYLOAD_TOO_LARGE", "message": "Mapping request exceeds the size limit" }
            }
          }
        }
      },
      "MappingNeedsReview": {
        "description": "The mapping is ambiguous, incomplete, references an unknown source path, or fails Canonical Product validation; no canonical data is returned",
        "content": {
          "application/json": {
            "example": {
              "status": "needsReview",
              "canonicalVersion": "Product-v1",
              "mapping": { "sku": "/ProductCode" },
              "confidence": "low",
              "unmappedFields": ["name", "category", "price"],
              "warnings": ["Required target fields could not be mapped confidently"]
            }
          }
        }
      },
      "MappingBadGateway": {
        "description": "The Node Process API received an invalid response from the Python mapping service",
        "content": {
          "application/json": {
            "example": {
              "success": false,
              "error": { "code": "MAPPING_SERVICE_INVALID_RESPONSE", "message": "The request could not be completed" }
            }
          }
        }
      },
      "MappingUnavailable": {
        "description": "Gemini or the Python mapping service is unavailable, the API key is invalid, or the quota is exhausted",
        "content": {
          "application/json": {
            "example": {
              "status": "error",
              "error": { "code": "GEMINI_API_ERROR", "message": "Gemini API returned an error" }
            }
          }
        }
      },
      "MappingTimeout": {
        "description": "Gemini or the internal mapping request timed out",
        "content": {
          "application/json": {
            "example": {
              "status": "error",
              "error": { "code": "GEMINI_TIMEOUT", "message": "Gemini did not respond before the timeout" }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "INVALID_SKU", "message": "Invalid SKU" } } } }
      },
      "InsufficientStock": {
        "description": "One or more requested SKUs do not have sufficient available inventory",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "INSUFFICIENT_STOCK", "message": "Insufficient stock for SKU SKU123" } } } }
      },
      "IdempotencyConflict": {
        "description": "The eventId was already used for a different shipment request",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "IDEMPOTENCY_CONFLICT", "message": "eventId was already used for a different shipment" } } } }
      },
      "NotFound": {
        "description": "SKU or route not found",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "SKU_NOT_FOUND", "message": "SKU was not found" } } } }
      },
      "BadGateway": {
        "description": "WMS returned invalid data",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "WMS_INVALID_RESPONSE", "message": "WMS returned invalid inventory data" } } } }
      },
      "ServiceUnavailable": {
        "description": "WMS is unavailable",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "WMS_UNAVAILABLE", "message": "The request could not be completed" } } } }
      },
      "GatewayTimeout": {
        "description": "WMS request timed out",
        "content": { "application/json": { "example": { "success": false, "error": { "code": "WMS_TIMEOUT", "message": "The request could not be completed" } } } }
      }
    }
  }
}
